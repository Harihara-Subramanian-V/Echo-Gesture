<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- CameraX Live Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Real-time Hand Landmark Skeleton Overlay -->
    <com.echogesture.app.ui.HandLandmarkOverlayView
        android:id="@+id/landmarkOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Engineering Diagnostic HUD Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/diagnosticHudCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_medium"
        app:cardBackgroundColor="@color/hud_background"
        app:cardCornerRadius="@dimen/corner_radius_hud"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Title & Status Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvHudTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_diagnostic_hud"
                    android:textColor="@color/hud_accent_cyan"
                    android:textSize="@dimen/text_size_hud_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFpsInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_fps"
                    android:textColor="@color/hud_accent_green"
                    android:textSize="@dimen/text_size_hud_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#22FFFFFF" />

            <!-- Pipeline State & Camera Details -->
            <TextView
                android:id="@+id/tvRecognitionState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_waiting_for_hands"
                android:textColor="@color/hud_accent_amber"
                android:textSize="@dimen/text_size_hud_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCameraStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_camera_status"
                android:textColor="@color/hud_text_primary"
                android:textSize="@dimen/text_size_hud_body" />

            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_model_ready"
                android:textColor="@color/hud_text_secondary"
                android:textSize="@dimen/text_size_hud_body" />

            <TextView
                android:id="@+id/tvLatencyBreakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_latency_breakdown"
                android:textColor="@color/hud_accent_green"
                android:textSize="@dimen/text_size_hud_body" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Recognition Hero Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heroSignCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_medium"
        android:layout_marginEnd="@dimen/padding_medium"
        android:layout_marginBottom="@dimen/padding_small"
        app:cardBackgroundColor="@color/hud_background"
        app:cardCornerRadius="@dimen/corner_radius_hud"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/speechButtonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/padding_medium">

            <TextView
                android:id="@+id/tvRecognizedSign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_recognized_sign"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_hero_sign"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:text="@string/label_confidence"
                android:textColor="@color/hud_accent_blue"
                android:textSize="@dimen/text_size_confidence"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTopCandidates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:text="@string/label_top_candidates"
                android:textColor="@color/hud_text_secondary"
                android:textSize="@dimen/text_size_top_candidates" />

            <!-- Speech Status Indicator -->
            <TextView
                android:id="@+id/tvSpeechStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/label_speech_ready"
                android:textColor="@color/hud_accent_cyan"
                android:textSize="@dimen/text_size_status"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Speech Action Controls Row -->
    <LinearLayout
        android:id="@+id/speechButtonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/padding_medium"
        android:layout_marginEnd="@dimen/padding_medium"
        android:layout_marginBottom="@dimen/padding_small"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSpeech"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin_tiny"
            android:text="@string/action_speech_on"
            android:textSize="@dimen/text_size_status"
            app:cornerRadius="@dimen/corner_radius_hud" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_tiny"
            android:layout_marginEnd="@dimen/margin_tiny"
            android:text="@string/action_replay"
            android:textSize="@dimen/text_size_status"
            app:cornerRadius="@dimen/corner_radius_hud" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_tiny"
            android:text="@string/action_clear"
            android:textSize="@dimen/text_size_status"
            app:cornerRadius="@dimen/corner_radius_hud" />
    </LinearLayout>

    <!-- Bottom Control Row -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/padding_medium"
        android:layout_marginEnd="@dimen/padding_medium"
        android:layout_marginBottom="@dimen/padding_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleCapture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin_small"
            android:text="@string/action_stop"
            app:cornerRadius="@dimen/corner_radius_hud" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_small"
            android:text="@string/action_switch_camera"
            app:cornerRadius="@dimen/corner_radius_hud" />
    </LinearLayout>

    <!-- Permission Fallback View -->
    <LinearLayout
        android:id="@+id/permissionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/padding_large"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvPermissionRationale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/label_camera_permission_required"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:text="@string/action_grant_permission" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
