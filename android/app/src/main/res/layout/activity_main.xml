<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- CameraX Live Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Top Engineering Diagnostic HUD Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/diagnosticHudCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_medium"
        app:cardBackgroundColor="@color/hud_background"
        app:cardCornerRadius="@dimen/corner_radius_hud"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <TextView
                android:id="@+id/tvHudTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_diagnostic_hud"
                android:textColor="@color/hud_accent_green"
                android:textSize="@dimen/text_size_hud_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCameraStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:text="@string/label_camera_status"
                android:textColor="@color/hud_text_primary"
                android:textSize="@dimen/text_size_hud_body" />

            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_model_status"
                android:textColor="@color/hud_text_primary"
                android:textSize="@dimen/text_size_hud_body" />

            <TextView
                android:id="@+id/tvTensorContract"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_input_tensor"
                android:textColor="@color/hud_text_secondary"
                android:textSize="@dimen/text_size_hud_body" />

            <TextView
                android:id="@+id/tvLatency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_inference_latency"
                android:textColor="@color/hud_accent_amber"
                android:textSize="@dimen/text_size_hud_body" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Recognition Hero Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heroSignCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_medium"
        app:cardBackgroundColor="@color/hud_background"
        app:cardCornerRadius="@dimen/corner_radius_hud"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnToggleCapture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/padding_medium">

            <TextView
                android:id="@+id/tvRecognizedSign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_recognized_sign"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_hero_sign"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_confidence"
                android:textColor="@color/hud_accent_blue"
                android:textSize="@dimen/text_size_confidence" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Toggle Capture Control Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleCapture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_medium"
        android:text="@string/action_stop"
        app:cornerRadius="@dimen/corner_radius_hud"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Permission Fallback View -->
    <LinearLayout
        android:id="@+id/permissionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/padding_large"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvPermissionRationale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/label_camera_permission_required"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:text="@string/action_grant_permission" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
